<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Sigue Wallet</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen">
  <nav class="bg-gray-800 border-b border-gray-700 px-6 py-4">
    <div class="flex items-center justify-between">
      <a href="/dashboard" class="text-xl font-bold text-emerald-400">Sigue Wallet</a>
      <div class="flex items-center gap-4">
        <a href="/dashboard" class="hover:text-emerald-400 transition">Dashboard</a>
        <a href="/wallets" class="hover:text-emerald-400 transition">Billeteras</a>
        <span class="text-gray-400 text-sm">/ <%= username %></span>
        <a href="/logout" class="text-red-400 hover:text-red-300 text-sm transition">Salir</a>
      </div>
    </div>
  </nav>

  <main class="px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-bold">Mi Portafolio</h1>
      <a href="/wallets" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg text-sm transition">
        + Gestionar Billeteras
      </a>
    </div>

    <% if (wallets.length === 0) { %>
      <div class="bg-gray-800 rounded-xl p-12 border border-gray-700 text-center">
        <p class="text-gray-400 mb-4">No tenés billeteras cargadas</p>
        <a href="/wallets/new" class="inline-block bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-3 rounded-lg transition">
          Agregar tu primera billetera
        </a>
      </div>
    <% } else { %>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% wallets.forEach(wallet => { %>
          <div class="bg-gray-800 rounded-xl p-6 border border-gray-700">
            <div class="flex items-start justify-between mb-4">
              <div>
                <h3 class="font-bold text-lg"><%= wallet.alias %></h3>
                <p class="text-xs text-gray-400"><%= wallet.chain %> · <%= wallet.address.slice(0, 6) %>...<%= wallet.address.slice(-4) %></p>
              </div>
              <span class="text-xs bg-emerald-900 text-emerald-300 px-2 py-1 rounded uppercase"><%= wallet.chain %></span>
            </div>
            <div id="balances-<%= wallet.id %>" class="text-gray-400 text-sm">
              Cargando...
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
